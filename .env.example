# Copy this file to .env and fill in your values. .env is gitignored.
# strava.py loads these at startup via python-dotenv.

# Strava API app credentials (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=your_strava_client_secret

# Read by the `llm` library for OpenAI models. Not needed if you use `llm keys set`
# or a non-OpenAI model.
OPENAI_API_KEY=sk-...
